# Copy to .env (or set in your host's dashboard). No secrets are required to run this project.

# FastAPI backend port (Railway/Render inject this automatically; default 8000)
PORT=8000

# Next.js frontend only: URL of the FastAPI backend that /api/* is proxied to
# (see frontend/next.config.js). Defaults to http://localhost:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000
