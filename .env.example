# ============================================================================
# FMCG Deal Intelligence Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================================

# ── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://app.supabase.com → Project Settings → API

# Public URL (safe for frontend/browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Anon key — safe for browser, respects RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...YOUR_ANON_KEY

# Service role key — SERVER ONLY, never expose to browser, bypasses RLS
SUPABASE_SERVICE_KEY=eyJhbGciOi...YOUR_SERVICE_ROLE_KEY

# ── Anthropic / Claude ────────────────────────────────────────────────────────
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...YOUR_ANTHROPIC_KEY

# ── NewsAPI (optional) ────────────────────────────────────────────────────────
# Free tier: 100 requests/day. Get from: https://newsapi.org/register
NEWS_API_KEY=YOUR_NEWSAPI_KEY

# ── n8n Configuration ─────────────────────────────────────────────────────────
# Used in docker-compose.yml and n8n Code nodes

# Webhook base URL for n8n (used to trigger workflows from other workflows)
N8N_WEBHOOK_BASE_URL=http://localhost:5678

# n8n auth (set to true in production)
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme_admin_password

# 32-char encryption key for credentials stored in n8n
N8N_ENCRYPTION_KEY=changeme_32_char_encryption_key_1

# JWT secret for n8n user sessions
N8N_JWT_SECRET=changeme_jwt_secret_value

# n8n host config (update for production deployment)
N8N_HOST=localhost
N8N_PROTOCOL=http

# Trend detection threshold: company must appear >= N times to be marked TRENDING
TREND_THRESHOLD=3

# ── FastAPI Backend ───────────────────────────────────────────────────────────
# Railway/Render auto-sets PORT; defaults to 8000 for local dev
PORT=8000

# ── Next.js Frontend ─────────────────────────────────────────────────────────
# URL of the FastAPI backend (used for proxying /api/* requests)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Email / Newsletter Delivery (optional) ────────────────────────────────────
# Configure SMTP for n8n to send newsletters via email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=fmcg-intel@yourdomain.com

# ── Timezone ──────────────────────────────────────────────────────────────────
# Used in n8n scheduler (cron jobs run in this timezone)
TZ=Asia/Kolkata
